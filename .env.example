# Copy to .env and fill in. Everything here can also live in config.json for
# local development — the environment wins when both are set (utils/config.js).
# Never commit the filled-in .env; it is gitignored.

# --- Discord ----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application ID from the same page -> General Information
DISCORD_CLIENT_ID=
# Right-click your server -> Copy Server ID (needs Developer Mode on).
# Slash commands are registered per-guild, which is why this is required.
DISCORD_GUILD_ID=

# --- Model provider ---------------------------------------------------------
# One of: openrouter (default), groq, gemini, cerebras, openai, or omit and set
# LLM_BASE_URL yourself for anything else OpenAI-compatible.
LLM_PROVIDER=openrouter

# Key from https://openrouter.ai/keys
LLM_API_KEY=

# Optional. The provider preset supplies a sensible default, so only set this
# to pin a specific model.
#
# Note on OpenRouter free models (IDs ending in :free): they are capped at
# 20 requests/minute and 50 requests/day on an account that has never bought
# credit — enough to try the bot out, not enough to leave it running in a busy
# server. A one-off $10 top-up raises the daily cap to 1,000. Paid models are
# billed per token and have no daily cap; llama-3.3-70b-instruct costs a
# fraction of a cent per reply.
#LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional OpenRouter attribution — makes the bot show up as itself in your
# OpenRouter dashboard rather than as anonymous traffic.
#APP_URL=https://github.com/paulliy/limmygrok
#APP_NAME=limmygrok

# --- Behaviour --------------------------------------------------------------
# Extra names the bot answers to, comma-separated, on top of its username.
#BOT_ALIASES=limmy,gene

# Override the bot's persona entirely. Leave unset to use the built-in one,
# which is what the learned server dialect gets layered onto.
#SYSTEM_PROMPT=

# Set to 1 to log full prompts and conversation memory. Off by default: on a
# shared VM it is noise in the journal and an extra copy of everyone's chat.
#DEBUG_PAYLOADS=0

# Where the SQLite database lives. The Docker image sets this to /data, which
# docker-compose.yml backs with a named volume.
#DATA_DIR=/data
